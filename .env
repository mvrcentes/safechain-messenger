# Database configuration for SafeChain
POSTGRES_CONTAINER_NAME=safechain-from-docker-compose

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# if you change the port, make sure to change it also in ./backend/.env
POSTGRES_LOCAL_PORT=5454 # Local port where PostgreSQL is running
POSTGRES_DOCKER_PORT=5432

# Backend configuration for SafeChain
# if you change the port, make sure to change it also in ./frontend/.env 
BACKEND_LOCAL_PORT=5001 # Local port where the backend server is running
BACKEND_DOCKER_PORT=4000 # Docker port where the backend server is running

# Frontend configuration for SafeChain
FRONTEND_LOCAL_PORT=5002 # Local port where the frontend server is running
FRONTEND_DOCKER_PORT=5173 # Docker port where the frontend server is running