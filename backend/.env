PORT=4000

JWT_SECRET=secret
JWT_EXPIRATION=15m

# Database configuration for SafeChain local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
# Database configuration for SafeChain Docker development
DATABASE_URL="postgresql://postgres:postgres@safechain-from-docker-compose:5432/postgres?schema=public"


POSTGRES_CONTAINER_NAME=safechain-postgres

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

POSTGRES_LOCAL_PORT=5454
POSTGRES_DOCKER_PORT=5432

ORIGIN_PORT=5173