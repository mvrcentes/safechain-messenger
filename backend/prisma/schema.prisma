generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String
  mfaSecret        String?
  publicKey        String?   @db.Text
  signingPublicKey String?   @db.Text
  createdAt        DateTime  @default(now())
  sessions         Session[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  groups           Group[]   @relation("GroupMembers")

  PreKey PreKey[]

  GroupKeyDelivery GroupKeyDelivery[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Message {
  id Int @id @default(autoincrement())

  fromUser   User @relation("SentMessages", fields: [fromUserId], references: [id])
  fromUserId Int

  toUser   User? @relation("ReceivedMessages", fields: [toUserId], references: [id])
  toUserId Int?

  group   Group? @relation(fields: [groupId], references: [id])
  groupId Int?

  content   String
  createdAt DateTime @default(now())

  blockchainBlock BlockchainBlock?
}

model Group {
  id        Int       @id @default(autoincrement())
  name      String
  members   User[]    @relation("GroupMembers")
  messages  Message[]
  createdAt DateTime  @default(now())

  GroupKeyDelivery GroupKeyDelivery[]
}

model PreKey {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  type      String // "IK" | "SPK" | "OPK"
  publicKey String  @db.Text
  used      Boolean @default(false)
}

model GroupKeyDelivery {
  id           Int     @id @default(autoincrement())
  groupId      Int
  userId       Int
  encryptedKey String  @db.Text
  delivered    Boolean @default(false)
  group        Group   @relation(fields: [groupId], references: [id])
  user         User    @relation(fields: [userId], references: [id])
  ephemeralKey String? @db.Text
  opkIndex     Int?
  opkHash     String? @db.Text

  @@unique([groupId, userId])
}


model BlockchainBlock {
  id           Int      @id @default(autoincrement())
  previousHash String
  currentHash  String   @unique
  messageId    Int      @unique
  message      Message  @relation(fields: [messageId], references: [id])
  createdAt    DateTime @default(now())
}
